# AWS-mode settings for the FastAPI app / dashboard.
#
# Do NOT copy this over .env. The local stack keeps running on 8020 with the
# existing .env; these values are exported in a separate shell (or written to a
# second env file) when you want a second instance on another port pointed at
# the deployed Redshift warehouse:
#
#   $env:WAREHOUSE_HOST = "..."          # or: set -a; . ./.env.aws; set +a
#   python -m uvicorn api.main:app --port 8120
#
# Values come from .aws-deploy.json, written by scripts/deploy_aws.py.
# The password is NOT here: it lives in Secrets Manager (ManageAdminPassword).
# See docs/AWS-DEPLOYMENT.md section 6 for the one-liner that reads it.

AWS_MODE=true
AWS_REGION=ap-south-1

# ---- Warehouse: Amazon Redshift Serverless --------------------------------
WAREHOUSE_HOST=divakar-dev.XXXXXXXXXXXX.ap-south-1.redshift-serverless.amazonaws.com
WAREHOUSE_PORT=5439
WAREHOUSE_DB=analytics
WAREHOUSE_USER=deuser
WAREHOUSE_PASSWORD=
# psycopg2 speaks Redshift's protocol dialect; psycopg3 needs prepare_threshold=None
WAREHOUSE_DRIVER=psycopg2
# Redshift Serverless is deployed with require_ssl=true
WAREHOUSE_SSL=true
WAREHOUSE_SCHEMA=dwh

# ---- Lake: real Amazon S3 -------------------------------------------------
LAKE_BACKEND=s3
BRONZE_BUCKET=divakar-lake-bronze-dev-XXXXXXXXXXXX-ap-south-1
SILVER_BUCKET=divakar-lake-silver-dev-XXXXXXXXXXXX-ap-south-1
GOLD_BUCKET=divakar-lake-gold-dev-XXXXXXXXXXXX-ap-south-1
ARTIFACTS_BUCKET=divakar-lake-artifacts-dev-XXXXXXXXXXXX-ap-south-1
